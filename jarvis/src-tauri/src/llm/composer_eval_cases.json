[
  {
    "id": "trigger_then_echo",
    "description": "when I say open notepad then open notepad",
    "platform": "windows",
    "mock_output": "{\"kind\":\"command\",\"confidence\":0.9,\"summary\":\"Open Notepad on the left\",\"command\":{\"trigger\":\"open notepad\",\"match_mode\":\"phrase\",\"actions\":[{\"open_target\":{\"target\":\"notepad\",\"placement\":\"left_half\"}},{\"open_target\":{\"target\":\"notepad\",\"placement\":\"left_half\"}}]}}",
    "expect": {
      "kind": "command",
      "trigger_phrases": ["open notepad"],
      "match_mode": "phrase",
      "action_checks": [
        {"kind": "open_target", "target": "notepad", "placement": "left_half"}
      ],
      "max_actions": 1,
      "forbid_duplicate_actions": true,
      "warnings_contain": ["duplicate"]
    }
  },
  {
    "id": "trigger_quoted",
    "description": "When I say \"open notepad\", launch notepad",
    "platform": "windows",
    "mock_output": "{\"kind\":\"tool\",\"confidence\":0.8,\"summary\":\"Open notepad\",\"tool\":{\"name\":\"open_notepad\",\"display_name\":\"Open Notepad\",\"description\":\"Launch notepad\",\"parameters\":[],\"actions\":[{\"open_target\":{\"target\":\"notepad\"}}]}}",
    "expect": {
      "kind": "command",
      "trigger_phrases": ["open notepad"],
      "match_mode": "phrase",
      "action_checks": [
        {"kind": "open_target", "target": "notepad"}
      ],
      "tool_absent": true
    }
  },
  {
    "id": "multistep_notepad_paste",
    "description": "When I say notepad, open notepad in fullscreen and paste \"Hello World\" into a new note.",
    "platform": "windows",
    "mock_output": "{\"kind\":\"command\",\"confidence\":0.9,\"summary\":\"Open Notepad fullscreen and paste Hello World\",\"command\":{\"trigger\":\"notepad\",\"match_mode\":\"phrase\",\"actions\":[{\"open_target\":{\"target\":\"notepad\",\"placement\":\"maximize\"}},{\"set_clipboard\":{\"text\":\"Hello World\"}},{\"send_keys\":{\"keys\":\"^v\"}}]}}",
    "expect": {
      "kind": "command",
      "trigger_phrases": ["notepad"],
      "match_mode": "phrase",
      "action_checks": [
        {"kind": "open_target", "target": "notepad", "placement": "maximize"},
        {"kind": "set_clipboard", "text": "Hello World"},
        {"kind": "send_keys", "keys": "^v"}
      ],
      "max_actions": 3
    }
  },
