  {
    "id": "prefix_remainder",
    "description": "When I say fetch, get the URL from what I say and open it",
    "mock_output": "{\"kind\":\"command\",\"confidence\":0.85,\"summary\":\"Fetch URL from speech then open it\",\"command\":{\"trigger\":\"fetch\",\"match_mode\":\"prefix\",\"actions\":[{\"http_get\":{\"url\":\"{{remainder}}\"}},{\"open_target\":{\"target\":\"{{last_result}}\"}}]}}",
    "expect": {
      "kind": "command",
      "trigger_phrases": ["fetch"],
      "match_mode": "prefix",
      "action_checks": [
        {"kind": "http_get", "url": "{{remainder}}"},
        {"kind": "open_target", "target": "{{last_result}}"}
      ],
      "max_actions": 2
    }
  },
  {
