{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jarvis",
  "version": "0.1.0",
  "identifier": "com.jarvis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "hud",
        "title": "JARVIS",
        "width": 480,
        "height": 172,
        "minWidth": 120,
        "maxWidth": 480,
        "minHeight": 72,
        "maxHeight": 172,
        "resizable": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#00000000",
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "editor",
        "title": "VLI",
        "url": "editor.html",
        "width": 900,
        "height": 600,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#00000000",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    },
    "resources": [
      "resources/ggml-base.en.bin",
      "resources/ggml-tiny.en.bin",
      "resources/oww/melspectrogram.onnx",
      "resources/oww/embedding_model.onnx",
      "resources/oww/hey_jarvis_v0.1.onnx",
      "resources/qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "resources/qwen2.5-3b-instruct-q4_k_m.gguf"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
